# HostelGuard AI - Environment Configuration
# Copy this file to .env and fill in your details

# Application
APP_NAME=HostelGuard AI
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database (Default is local SQLite, replace with Supabase/PostgreSQL for production)
DATABASE_URL=sqlite:///./hostelguard.db
# PostgreSQL / Supabase Example:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# WhatsApp Notification Configuration
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WARDEN_PHONE_NUMBER=+917843006100

# Android SMS Gateway Configuration (Physical SIM Gateway)
# Set SMS_ENABLED=true to trigger real SMS on HIGH and CRITICAL alerts
SMS_ENABLED=true
# Android Phone's local IP and port on the same Wi-Fi network (e.g., http://192.168.1.105:8080)
SMS_GATEWAY_URL=http://192.168.1.100:8080
# Secure shared API key matching the Android Gateway companion app setting
SMS_GATEWAY_API_KEY=your_secure_gateway_key
SMS_GATEWAY_TIMEOUT_SECONDS=5.0

# AI Detection Thresholds
DEFAULT_CROWD_THRESHOLD=8
FALL_CONFIDENCE_THRESHOLD=0.80
FALL_DURATION_THRESHOLD_SECONDS=3.0
COOLDOWN_SUPPRESSION_SECONDS=60

# Demo Notification Mode (Set to True if testing without Meta API credentials)
DEMO_NOTIFICATION_MODE=True
